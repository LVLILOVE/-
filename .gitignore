# ============================================================
# 代码段功能：猫屿项目 Git 忽略规则（仓库根）
# - 过滤：虚拟环境 / node_modules / 构建产物 / 环境变量 / 数据库与上传
# - 规则均为「任意层级匹配」，对 cat-isle-backend / frontend 结构生效
# ============================================================

# ===== Python 虚拟环境 =====
venv/
.venv/

# ===== Node 依赖 =====
node_modules/

# ===== 构建产物 =====
dist/

# ===== Python 缓存 =====
__pycache__/
*.py[cod]

# ===== 环境变量与密钥（严禁入库）=====
.env
.env.*
!.env.example

# ===== 本地数据库与上传文件 =====
*.db
*.db-wal
*.db-shm
uploads/

# ===== 系统与编辑器杂项 =====
.DS_Store
Thumbs.db
*.local
