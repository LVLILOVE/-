<Slide style={{ width: 1280, height: 720, padding: '0 40px', background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ height: 80, width: '100%', background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 28px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 1 }}>电商销量预测系统 · 课程答辩演示</Text>
        <Text style={{ fontSize: 14, color: '#B9CCEF' }}>02 技术方案 · 技术选型</Text>
    </Box>

    <Box style={{ height: 580, width: '100%', flexDirection: 'row' }}>
        <Box style={{ width: 330, height: 580, background: '#0E3F8C', padding: '26px 26px', flexDirection: 'column' }}>
            <Text style={{ fontSize: 15, color: '#7BA3E0', letterSpacing: 2 }}>技术栈</Text>
            <Text style={{ fontSize: 30, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.28, marginTop: 10 }}>技术栈与四层架构</Text>
            <Box style={{ width: 44, height: 4, background: '#3D7BD9', marginTop: 14 }} />
            <Text style={{ fontSize: 16, color: '#C7D8F2', lineHeight: 1.6, marginTop: 14 }}>全部版本写入交付文档，换机器部署时不因依赖漂移改变行为。</Text>

            <Box style={{ flex: 1 }} />

            <Box style={{ width: 278, height: 176, borderRadius: 8, overflow: 'hidden', background: '#FFFFFF' }}>
                <Image src='assets/home.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'top' }} />
            </Box>
            <Text style={{ fontSize: 14, color: '#8FB0E4', lineHeight: 1.5, marginTop: 8 }}>首页：低频商品占比与覆盖率提示直接暴露给用户</Text>
        </Box>

        <Box style={{ width: 870, height: 580, paddingLeft: 30, flexDirection: 'column', justifyContent: 'center' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96, borderBottom: '1px solid #E5E7EB' }}>
                <Text style={{ width: 250, fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>api / v1　接入层</Text>
                <Text style={{ flex: 1, fontSize: 22, color: '#4A5568' }}>30 条路由、鉴权与请求校验</Text>
                <Text style={{ width: 200, fontSize: 17, color: '#3D7BD9', textAlign: 'right' }}>FastAPI 0.141.1</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96, borderBottom: '1px solid #E5E7EB' }}>
                <Text style={{ width: 250, fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>services　服务层</Text>
                <Text style={{ flex: 1, fontSize: 22, color: '#4A5568' }}>上传、训练、预测、导出编排</Text>
                <Text style={{ width: 200, fontSize: 17, color: '#3D7BD9', textAlign: 'right' }}>Uvicorn 0.35</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96, borderBottom: '1px solid #E5E7EB' }}>
                <Text style={{ width: 250, fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>dao　数据访问层</Text>
                <Text style={{ flex: 1, fontSize: 22, color: '#4A5568' }}>单库读写与 WAL 事务边界</Text>
                <Text style={{ width: 200, fontSize: 17, color: '#3D7BD9', textAlign: 'right' }}>SQLite 3 · WAL</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96, borderBottom: '1px solid #E5E7EB' }}>
                <Text style={{ width: 250, fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>app / algo　算法层</Text>
                <Text style={{ flex: 1, fontSize: 22, color: '#4A5568' }}>特征、训练、推理与三级降级</Text>
                <Text style={{ width: 200, fontSize: 17, color: '#3D7BD9', textAlign: 'right' }}>PyTorch 2.9.1+cu128</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'center', height: 96 }}>
                <Text style={{ width: 250, fontSize: 22, color: '#0E3F8C', fontWeight: 'bold' }}>web　前端层</Text>
                <Text style={{ flex: 1, fontSize: 22, color: '#4A5568' }}>13 个页面、图表懒加载</Text>
                <Text style={{ width: 200, fontSize: 17, color: '#3D7BD9', textAlign: 'right' }}>React 18.3.1</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>汇报人：吕治　·　2026 年 10 月　·　数据科学与大数据技术（2023.9–2027.6）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>07 / 18</Text>
    </Box>

    <Box style={{ height: 20, width: '100%' }} />
</Slide>
