<Slide style={{ width: 1280, height: 720, padding: '0 40px', background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ height: 80, width: '100%', background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 28px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 1 }}>电商销量预测系统 · 课程答辩演示</Text>
        <Text style={{ fontSize: 14, color: '#B9CCEF' }}>04 目标达成度 · 硬指标</Text>
    </Box>

    <Box style={{ height: 580, width: '100%', flexDirection: 'column' }}>
        <Box style={{ height: 68, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 32, color: '#0E3F8C', fontWeight: 'bold' }}>三项硬指标全部达标</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>全部取自样本外回测，基线为移动平均</Text>
        </Box>

        <Box style={{ height: 512, width: '100%', flexDirection: 'column' }}>
            <Box style={{ height: 268, width: '100%', flexDirection: 'row', alignItems: 'center', borderBottom: '1px solid #E5E7EB' }}>
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 62, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>14.26%</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 12 }}>销量加权 MAPE</Text>
                    <Box style={{ background: '#E8EFF8', borderRadius: 999, padding: '4px 14px', marginTop: 10 }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>红线 ≤ 20%，余量 5.74pp</Text>
                    </Box>
                </Box>
                <Box style={{ width: 1, height: 150, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 62, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>26.42%</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 12 }}>MAE 相对基线降低</Text>
                    <Box style={{ background: '#E8EFF8', borderRadius: 999, padding: '4px 14px', marginTop: 10 }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>红线 ≥ 15%，超出 11.4pp</Text>
                    </Box>
                </Box>
                <Box style={{ width: 1, height: 150, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 62, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>27.52%</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 12 }}>RMSE 相对基线降低</Text>
                    <Box style={{ background: '#E8EFF8', borderRadius: 999, padding: '4px 14px', marginTop: 10 }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>红线 ≥ 15%，超出 12.5pp</Text>
                    </Box>
                </Box>
                <Box style={{ width: 1, height: 150, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 62, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>83.95%</Text>
                    <Text style={{ fontSize: 19, color: '#4A5568', marginTop: 12 }}>达标序列占比</Text>
                    <Box style={{ background: '#E8EFF8', borderRadius: 999, padding: '4px 14px', marginTop: 10 }}>
                        <Text style={{ fontSize: 14, color: '#1E4FA8' }}>红线 ≥ 60%，超出 24pp</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ height: 244, width: '100%', flexDirection: 'row', paddingTop: 22 }}>
                <Box style={{ width: 776, paddingRight: 26, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#3D7BD9', letterSpacing: 2 }}>为什么这个数字可信</Text>
                    <Text style={{ fontSize: 27, color: '#0E3F8C', fontWeight: 'bold', marginTop: 8 }}>基线选的是移动平均，而不是随便一个弱方法</Text>
                    <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.6, marginTop: 12 }}>相对移动平均降低 26% 以上，说明模型确实学到了基线捕捉不到的时序结构，而不是靠基线本身的水平在撑指标。</Text>
                </Box>

                <Box style={{ width: 424, flexDirection: 'column' }}>
                    <Box style={{ width: '100%', height: 178, border: '1px solid #D6DCE5', borderRadius: 10, overflow: 'hidden', background: '#F7F9FC' }}>
                        <Image src='assets/result.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'top' }} />
                    </Box>
                    <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>图 3　预测结果页：指标卡与序列对比图</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>汇报人：吕治　·　2026 年 10 月　·　数据科学与大数据技术（2023.9–2027.6）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>13 / 18</Text>
    </Box>

    <Box style={{ height: 20, width: '100%' }} />
</Slide>
