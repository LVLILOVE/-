<Slide style={{ width: 1280, height: 720, padding: '0 40px', background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ height: 80, width: '100%', background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 28px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 1 }}>电商销量预测系统 · 课程答辩演示</Text>
        <Text style={{ fontSize: 14, color: '#B9CCEF' }}>01 项目概况</Text>
    </Box>

    <Box style={{ height: 580, width: '100%', flexDirection: 'row' }}>
        <Box style={{ width: 300, height: 580, background: '#0E3F8C', alignItems: 'center', justifyContent: 'center' }}>
            <Text style={{ fontSize: 150, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 2 }}>01</Text>
        </Box>

        <Box style={{ width: 900, height: 580, padding: '0 34px 0 46px', flexDirection: 'column', justifyContent: 'center' }}>
            <Text style={{ fontSize: 15, color: '#8B97A8', letterSpacing: 3 }}>CHAPTER ONE</Text>
            <Text style={{ fontSize: 44, color: '#0E3F8C', fontWeight: 'bold', marginTop: 12 }}>项目概况</Text>
            <Box style={{ width: 64, height: 4, background: '#3D7BD9', marginTop: 18 }} />

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 16, marginTop: 30 }}>
                <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>01</Text>
                </Box>
                <Text style={{ flex: 1, fontSize: 22, color: '#1A2230', lineHeight: 1.6 }}>业务问题：分仓补货长期依赖人工经验，长尾商品在稀疏历史下无据可依</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 16, marginTop: 20 }}>
                <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>02</Text>
                </Box>
                <Text style={{ flex: 1, fontSize: 22, color: '#1A2230', lineHeight: 1.6 }}>验收红线：销量加权 MAPE ≤ 20%，MAE / RMSE 相对移动平均基线降低 ≥ 15%</Text>
            </Box>

            <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 16, marginTop: 20 }}>
                <Box style={{ width: 34, height: 34, background: '#1E4FA8', borderRadius: 6, alignItems: 'center', justifyContent: 'center' }}>
                    <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold' }}>03</Text>
                </Box>
                <Text style={{ flex: 1, fontSize: 22, color: '#1A2230', lineHeight: 1.6 }}>系统规模：6 大功能模块、30 条 API 路径、13 个前端页面完整闭环</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>汇报人：吕治　·　2026 年 10 月　·　数据科学与大数据技术（2023.9–2027.6）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>03 / 18</Text>
    </Box>

    <Box style={{ height: 20, width: '100%' }} />
