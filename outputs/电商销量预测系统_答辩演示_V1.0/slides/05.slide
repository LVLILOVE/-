<Slide style={{ width: 1280, height: 720, padding: '0 40px', background: '#FFFFFF', flexDirection: 'column' }}>
    <Box style={{ height: 80, width: '100%', background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 28px' }}>
        <Text style={{ fontSize: 16, color: '#FFFFFF', fontWeight: 'bold', letterSpacing: 1 }}>电商销量预测系统 · 课程答辩演示</Text>
        <Text style={{ fontSize: 14, color: '#B9CCEF' }}>01 项目概况 · 系统全景</Text>
    </Box>

    <Box style={{ height: 580, width: '100%', flexDirection: 'column' }}>
        <Box style={{ height: 68, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
            <Text style={{ fontSize: 32, color: '#0E3F8C', fontWeight: 'bold' }}>系统全景：六大模块闭环</Text>
            <Text style={{ fontSize: 15, color: '#8B97A8' }}>接口数据来自 exports 的 OpenAPI 规范（自动导出）</Text>
        </Box>

        <Box style={{ height: 512, width: '100%', flexDirection: 'column' }}>
            <Box style={{ height: 244, width: '100%', flexDirection: 'row', alignItems: 'center', borderBottom: '1px solid #E5E7EB' }}>
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 76, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>06</Text>
                    <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 14 }}>功能模块</Text>
                    <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 6 }}>上传 / 特征 / 预测 / 可视化 / 历史 / 用户</Text>
                </Box>
                <Box style={{ width: 1, height: 132, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 76, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>30</Text>
                    <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 14 }}>API 路径</Text>
                    <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 6 }}>32 个操作 / 78 个 Schema</Text>
                </Box>
                <Box style={{ width: 1, height: 132, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 76, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>13</Text>
                    <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 14 }}>前端页面</Text>
                    <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 6 }}>含管理端看板与用户管理</Text>
                </Box>
                <Box style={{ width: 1, height: 132, background: '#E5E7EB' }} />
                <Box style={{ flex: 1, flexDirection: 'column', alignItems: 'center' }}>
                    <Text style={{ fontSize: 76, color: '#1E4FA8', fontWeight: 'bold', lineHeight: 1 }}>121</Text>
                    <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 14 }}>数据表列</Text>
                    <Text style={{ fontSize: 15, color: '#8B97A8', marginTop: 6 }}>8 张表 / 1 视图 / 3 触发器</Text>
                </Box>
            </Box>

            <Box style={{ height: 268, width: '100%', flexDirection: 'row', paddingTop: 22 }}>
                <Box style={{ width: 748, paddingRight: 26, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, color: '#3D7BD9', letterSpacing: 2 }}>洞察</Text>
                    <Text style={{ fontSize: 27, color: '#0E3F8C', fontWeight: 'bold', marginTop: 8 }}>模块边界不靠文档描述，而靠契约约束</Text>
                    <Text style={{ fontSize: 22, color: '#1A2230', lineHeight: 1.6, marginTop: 14 }}>四个数字背后是同一条链路：上传与校验 → 特征构建 → LSTM 推理 → 图表与导出 → 历史归档 → 按用户隔离。30 条接口全部在 OpenAPI 中显式声明，13 个页面都由真实接口驱动，没有写死的假数据。</Text>
                </Box>

                <Box style={{ width: 452, flexDirection: 'column' }}>
                    <Box style={{ width: '100%', height: 196, border: '1px solid #D6DCE5', borderRadius: 10, overflow: 'hidden', background: '#F7F9FC' }}>
                        <Image src='assets/admin_dash.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'top' }} />
                    </Box>
                    <Text style={{ fontSize: 14, color: '#8B97A8', marginTop: 8 }}>图 2　管理端看板（真实运行截图，Chromium 1600px 视口）</Text>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>汇报人：吕治　·　2026 年 10 月　·　数据科学与大数据技术（2023.9–2027.6）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>05 / 18</Text>
    </Box>

    <Box style={{ height: 20, width: '100%' }} />
</Slide>
