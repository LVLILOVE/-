                <Box style={{ flexDirection: 'row', alignItems: 'center', height: 46, borderBottom: '1px solid #E5E7EB' }}>
                    <Text style={{ width: 92, fontSize: 18, color: '#1E4FA8', fontWeight: 'bold' }}>EP-9</Text>
                    <Text style={{ flex: 1, fontSize: 19, color: '#1A2230' }}>性能、兼容与无障碍验收</Text>
                    <Text style={{ width: 198, fontSize: 15, color: '#8B97A8', textAlign: 'right' }}>真实浏览器渲染验证</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', height: 46 }}>
                    <Text style={{ width: 92, fontSize: 18, color: '#1E4FA8', fontWeight: 'bold' }}>EP-10</Text>
                    <Text style={{ flex: 1, fontSize: 19, color: '#1A2230' }}>文档交付与答辩准备</Text>
                    <Text style={{ width: 198, fontSize: 15, color: '#8B97A8', textAlign: 'right' }}>六份文档口径统一</Text>
                </Box>
            </Box>

            <Box style={{ width: 484, height: 512, paddingLeft: 24, flexDirection: 'column' }}>
                <Box style={{ height: 250, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: 14, flexDirection: 'column' }}>
                    <Box style={{ width: '100%', height: 196, borderRadius: 6, overflow: 'hidden', background: '#FFFFFF' }}>
                        <Image src='assets/history.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'top' }} />
                    </Box>
