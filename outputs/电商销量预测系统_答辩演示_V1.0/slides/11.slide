                <Box style={{ height: 246, background: '#FFFFFF', border: '1px solid #D6DCE5', borderRadius: 10, padding: '18px 20px', flexDirection: 'column', marginTop: 16 }}>
                    <Text style={{ fontSize: 20, color: '#0E3F8C', fontWeight: 'bold' }}>三道不可跳过的门禁</Text>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44, marginTop: 10 }}>
                        <Box style={{ width: 24, height: 24, background: '#1E4FA8', borderRadius: 5 }} />
                        <Text style={{ flex: 1, fontSize: 18, color: '#4A5568', paddingLeft: 12 }}>接口契约可被脚本自动校验</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44 }}>
                        <Box style={{ width: 24, height: 24, background: '#1E4FA8', borderRadius: 5 }} />
                        <Text style={{ flex: 1, fontSize: 18, color: '#4A5568', paddingLeft: 12 }}>真实浏览器渲染验证后才可交付</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 44 }}>
                        <Box style={{ width: 24, height: 24, background: '#1E4FA8', borderRadius: 5 }} />
                        <Text style={{ flex: 1, fontSize: 18, color: '#4A5568', paddingLeft: 12 }}>指标必须样本外回测，不看训练集</Text>
                    </Box>
                </Box>
            </Box>
        </Box>
    </Box>

    <Box style={{ height: 40, width: '100%', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>汇报人：吕治　·　2026 年 10 月　·　数据科学与大数据技术（2023.9–2027.6）</Text>
        <Text style={{ fontSize: 14, color: '#1E4FA8', fontWeight: 'bold' }}>11 / 18</Text>
